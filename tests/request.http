
@host = http://localhost:3000
@baseUrl = {{host}}/api/products

### 1.- Crear un producto (POST)
# @name createProduct
POST {{baseUrl}}
Content-Type: application/json

{
    "name": "Monitor Gaming",
    "description": "Panel IPS 165Hz",
    "price": 249.99,
    "stock": 14,
    "category": "perifericos"
}

###
# Guarda el _id del producto recién creado para usarlo en las demás peticiones
@productId = {{createProduct.response.body.data._id}}

### 2.- Obtener todos los productos (GET)
GET {{baseUrl}}
Accept: application/json

### 3.- Obtener un producto por id (GET)
GET {{baseUrl}}/{{productId}}
Accept: application/json

### 4.- Actualizar un producto (PUT)
PUT {{baseUrl}}/{{productId}}
Content-Type: application/json

{
    "price": 219.99,
    "stock": 10
}

### 5.- Eliminar un producto (DELETE)
DELETE {{baseUrl}}/{{productId}}

### 6.- Error 404: ruta inexistente
GET {{host}}/ruta-falsa

### 7.- Error 400: id no válido
GET {{baseUrl}}/123-id-invalido

### 8.- Error 400: validación (faltan campos obligatorios)
POST {{baseUrl}}
Content-Type: application/json

{
    "name": "Sin precio ni categoría"
}